#!/bin/sh
#
# TMI8150 pan/tilt + IR-cut (Tapo C210 v3). GPIO 38 (H-bridge power) is
# raised by muxes.sh earlier in boot.
#
# Range and speed are the values calibrated under thingino
# (steps_pan 7850, steps_tilt 1850, speed 430). Tilt inversion is built into
# the module (package/tmi8152-motor patch 0002).

MODS=/lib/modules/$(uname -r)/extra
HMAX=7850
VMAX=1850
SPEED=430

start() {
	echo "Loading TMI8150 pan/tilt + IR-cut driver..."
	grep -q '^tmi8152_spi_dev ' /proc/modules || insmod $MODS/tmi8152_spi_dev.ko || return 1
	grep -q '^motor ' /proc/modules || insmod $MODS/motor.ko hmaxstep=$HMAX vmaxstep=$VMAX || return 1
	tmi-ptz -s $SPEED
	# Homing runs into both end stops and returns to the centre; it takes a
	# while, so do not hold up the rest of the boot.
	( tmi-ptz -r -w && logger -t ptz "homed: $(tmi-ptz -j)" ) </dev/null >/dev/null 2>&1 &
}

stop() {
	tmi-ptz -S 2>/dev/null
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
