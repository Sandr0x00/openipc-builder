#!/bin/sh
#
# Automatic day/night for the Tapo C210 v3: IR-cut through the TMI8150
# (/dev/tmi8152_ir_cut, loaded by S60ptz), IR LEDs on GPIO 49, black-and-white
# through Majestic (started by S95majestic). See /usr/sbin/daynight.
#
# Live override: echo auto|day|night > /etc/daynight.force

DAEMON=/usr/sbin/daynight
PIDFILE=/var/run/daynight.pid

start() {
	echo "Starting day/night controller..."
	[ -e /dev/tmi8152_ir_cut ] || echo "daynight: /dev/tmi8152_ir_cut missing, IR-cut will not move" >&2
	start-stop-daemon -S -b -m -p "$PIDFILE" -x /bin/sh -- "$DAEMON"
}

stop() {
	start-stop-daemon -K -p "$PIDFILE" 2>/dev/null
	rm -f "$PIDFILE"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
